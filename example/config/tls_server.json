{
    "apx-server": {
        "apx-cache-enabled": false,
        "apx-cache-path": "",
        "max-num-events": 200,
        "security": {
            "require-signed-nodes": true,
            "trusted-keys": [
                "nodes/certs/client_pubkey.pem"
            ]
        }
    },
    "socket-server-extension": {
        "enabled": true,
        "tcp-port": 5000,
        "tcp-tag": "tcp",
        "unix-file": "/tmp/apx.socket",
        "unix-tag": "local"
    },
    "tls-server-extension": {
        "enabled": true,
        "tcp-port": 5020,
        "tag": "tls",
        "server-cert": "tests/certs/server_cert.pem",
        "server-key": "tests/certs/server_key.pem",
        "ca-cert": "tests/certs/ca_cert.pem",
        "require-client-cert": false
    },
    "textlog-extension": {
        "enabled": true,
        "file-enabled": true,
        "file-path": "",
        "syslog-enabled": false
    },
    "monitor-extension": {
        "enabled": true
    }
}
